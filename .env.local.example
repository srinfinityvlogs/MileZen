# Copy this to .env.local and fill in real values.
# NEVER commit .env.local — it's already in .gitignore.

# --- Supabase (from your Supabase project settings > API) ---
# There is no auth/login in this app — the anon key only ever reads the
# public reference catalog (card_products, mcc_rules, award_charts,
# award_route_charts, transfer_partners, programmes, issuers).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVICE ROLE KEY: full DB access, bypasses ALL Row Level Security.
# Server-side only, NEVER prefix with NEXT_PUBLIC_. Used only by the
# reference-data ingestion script (npm run ingest:reference) — nothing
# in the deployed app itself uses this, since there's no admin/user
# action anywhere that needs elevated privileges.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM provider (server-side only, used for the AI concierge) ---
# Groq: genuinely free tier, OpenAI-compatible API, no data retention by
# default (see console.groq.com/docs/your-data). Get a key at
# console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional override — defaults to llama-3.3-70b-versatile in code if unset.
CONCIERGE_MODEL=llama-3.3-70b-versatile

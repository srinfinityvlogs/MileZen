# Copy this to .env.local and fill in real values.
# NEVER commit .env.local — it's already in .gitignore.

# --- Supabase (from your Supabase project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVICE ROLE KEY: full DB access, bypasses ALL Row Level Security.
# - Server-side only. NEVER prefix with NEXT_PUBLIC_.
# - NEVER import it in any file under app/ that runs on the client.
# - Only used in: trusted server code (reference-data ingestion scripts,
#   scheduled jobs). Everyday user requests must use the anon key + RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM provider (server-side only, used for the AI concierge) ---
# Groq: genuinely free tier, OpenAI-compatible API, no data retention by
# default (see console.groq.com/docs/your-data). Get a key at
# console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional override — defaults to llama-3.3-70b-versatile in code if unset.
CONCIERGE_MODEL=llama-3.3-70b-versatile

# --- Inbound email parsing (for "forward your card alert email") ---
INBOUND_EMAIL_WEBHOOK_SECRET=generate-a-random-secret

# --- Reminders cron ---
# Generate with: openssl rand -hex 32
# Set the SAME value in Vercel's project env vars — Vercel then auto-sends
# it as a Bearer token on scheduled invocations (see README).
CRON_SECRET=generate-a-random-secret

# --- Transactional email (reminder notifications) ---
# Any provider works — this scaffold calls Resend's HTTP API directly.
RESEND_API_KEY=your-resend-api-key
REMINDER_EMAIL_FROM=MileZen <reminders@yourdomain.com>

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
